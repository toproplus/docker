# timeerror/php:7.4.29           => PHP_VERSION=7.4.29 FFMPEG_VERSION=7.1.1 MONGODB_VERSION=1.20
# timeerror/php:7.4.29-ffmpeg4.4 => PHP_VERSION=7.4.29 FFMPEG_VERSION=4.4.6 MONGODB_VERSION=1.15
# timeerror/php:7.4.33           => PHP_VERSION=7.4.33 FFMPEG_VERSION=7.1.1 MONGODB_VERSION=1.20
# timeerror/php:7.4.33-scws      => PHP_VERSION=7.4.33 FFMPEG_VERSION=7.1.1 MONGODB_VERSION=1.20

ARG PHP_VERSION=7.4.33
# 使用多阶段构建以减小最终镜像体积
FROM php:${PHP_VERSION}-fpm-alpine AS builder

ARG FFMPEG_VERSION=7.1.1
ARG MONGODB_VERSION=1.20

RUN apk add --no-cache --virtual .build-deps build-base bash curl openssl c-ares unzip nasm x264-dev x265-dev libvpx-dev fdk-aac-dev autoconf \
    gcc g++ make libc-dev bzip2 bzip2-dev \
    && rm -rf /var/cache/apk/*

# 下载并编译 SCWS 核心库
RUN cd /tmp \
    && curl -fSL 'http://www.xunsearch.com/scws/down/scws-1.2.3.tar.bz2' -o scws-1.2.3.tar.bz2 \
    && tar -xjf scws-1.2.3.tar.bz2 \
    && cd scws-1.2.3 \
    && ./configure --prefix=/usr/local/scws \
    && make -j$(nproc) \
    && make install

    # 编译 SCWS PHP 扩展
RUN cd /tmp/scws-1.2.3/phpext \
    && phpize \
    && ./configure --with-php-config=/usr/local/bin/php-config --with-scws=/usr/local/scws \
    && make -j$(nproc) \
    && make install

RUN wget http://www.tortall.net/projects/yasm/releases/yasm-1.3.0.tar.gz && tar -zxvf yasm-1.3.0.tar.gz \
 && rm yasm-1.3.0.tar.gz && cd yasm-1.3.0 && ./configure && make && make install && cd ../ && rm -rf yasm-1.3.0

RUN wget https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.gz && tar -zxvf ffmpeg-${FFMPEG_VERSION}.tar.gz \
    && rm ffmpeg-${FFMPEG_VERSION}.tar.gz \
    && cd ffmpeg-${FFMPEG_VERSION} && ./configure --enable-gpl --enable-libx264 --enable-libx265 --enable-libvpx --enable-libfdk-aac --enable-nonfree \
    && make -j2 V=1 && make install && cd ../ && rm -rf ffmpeg-${FFMPEG_VERSION}

#RUN set -eux && sed -i 's/dl-cdn.alpinelinux.org/mirrors.ustc.edu.cn/g' /etc/apk/repositories

COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

RUN install-php-extensions gd imagick pdo_mysql pdo_pgsql amqp bcmath opcache zip redis sockets event decimal soap pcre pcntl posix
# 7.4特别安装
RUN install-php-extensions mysqli mcrypt 

# 只安装，不启用，通过入口脚本动态启用

# 容易安装失败的先安装
# 开发、调试与性能分析扩展
RUN IPE_DONT_ENABLE=1 install-php-extensions excimer

RUN IPE_DONT_ENABLE=1 install-php-extensions memcached apcu ssh2 protobuf \
    bitset uuid igbinary brotli bz2 calendar csv dba ds enchant ev \
    exif ffi grpc maxminddb xsl gettext intl snmp msgpack snappy inotify \
    rdkafka ioncube_loader swoole-^4.8@stable

RUN IPE_DONT_ENABLE=1 install-php-extensions mongodb-^${MONGODB_VERSION}@stable


# 删除纯构建时依赖    
RUN apk del --no-cache build-base .build-deps

# ========== 最终运行镜像 ==========
FROM php:7.4.33-fpm-alpine

# 从构建阶段复制 FFmpeg 和 PHP 扩展
COPY --from=builder /lib /lib
COPY --from=builder /usr/lib /usr/lib
COPY --from=builder /usr/share /usr/share
COPY --from=builder /usr/local /usr/local
COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /usr/local/etc /usr/local/etc

RUN chmod -R 755 /usr/local/lib/php/extensions/no-debug-non-zts-*

RUN echo "export TERM=xterm" >> /root/.bashrc \
    && mv /usr/local/etc/php-fpm.conf /usr/local/etc/php-fpm.conf.backup \
    && mkdir /php \
    && ln -s /php/php.ini /usr/local/etc/php/php.ini \
    && ln -s /php/php-fpm.conf /usr/local/etc/php-fpm.conf

# 安装运行时依赖，确保基础环境完整  
RUN apk add --no-cache bash openssl c-ares unzip libvpx x264-libs x265-libs fdk-aac libc-dev bzip2 bzip2-dev \
    && rm -rf /var/cache/apk/*

# 下载 UTF-8 词典
RUN cd /usr/local/scws/etc \
    && curl -fSL 'http://www.xunsearch.com/scws/down/scws-dict-chs-utf8.tar.bz2' -o dict-utf8.tar.bz2 \
    && tar -xjf dict-utf8.tar.bz2 \
    && rm dict-utf8.tar.bz2

# 启用 SCWS 扩展并配置默认词典路径
RUN echo "extension=scws.so" > /usr/local/etc/php/conf.d/docker-php-ext-scws.ini \
    && echo "scws.default.charset=utf8" >> /usr/local/etc/php/conf.d/docker-php-ext-scws.ini \
    && echo "scws.default.fpath=/usr/local/scws/etc" >> /usr/local/etc/php/conf.d/docker-php-ext-scws.ini

# 可选：将词典目录加入环境变量，方便 PHP 代码中引用
ENV SCWS_DICT_PATH=/usr/local/scws/etc

WORKDIR /www

# 入口脚本
COPY conf/entrypoint.sh /php/entrypoint.sh
RUN chmod 755 /php/entrypoint.sh
ENTRYPOINT ["/php/entrypoint.sh"]

CMD php-fpm
