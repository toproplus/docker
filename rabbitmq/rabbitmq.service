[Unit]
Description=rabbitmq
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=0
ExecStartPre=-/usr/bin/docker stop rabbitmq
ExecStartPre=-/usr/bin/docker kill rabbitmq
ExecStartPre=-/usr/bin/docker rm rabbitmq
ExecStartPre=-/usr/bin/docker network create nginx-network
ExecStart=/usr/bin/docker run --hostname rabbitmq --name=rabbitmq --net=nginx-network -p 5672:5672 -p 15672:15672 -e RABBITMQ_DEFAULT_USER=guest -e RABBITMQ_DEFAULT_PASS=vW0aI3mF3gC6hD4nW3tA3nF4iX8lA2zO \
-v /home/core/data/rabbitmq/lib:/var/lib/rabbitmq -v /home/core/data/rabbitmq/config:/etc/rabbitmq -v /home/core/data/rabbitmq/log:/var/log/rabbitmq rabbitmq:4.2.3 
ExecStop=/usr/bin/docker stop rabbitmq

[Install]
WantedBy=multi-user.target

